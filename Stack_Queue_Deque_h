class DequeNode
{
public:
    int data;
    DequeNode *previous;
    DequeNode *next;

    explicit DequeNode(int value) : data(value), previous(nullptr), next(nullptr) {}
};

class LinkedListDeque
{
private:
    DequeNode *front = nullptr;
    DequeNode *back = nullptr;

public:
    bool empty() const
    {
        return front == nullptr;
    }

    bool pushFront(int value)
    {
        DequeNode *node = new DequeNode(value);
        node->next = front;
        if (front)
        {
            front->previous = node;
        }
        else
        {
            back = node;
        }
        front = node;
        return true;
    }

    bool pushBack(int value)
    {
        DequeNode *node = new DequeNode(value);
        node->previous = back;
        if (back)
        {
            back->next = node;
        }
        else
        {
            front = node;
        }
        back = node;
        return true;
    }

    bool popFront(int &value)
    {
        if (empty())
        {
            return false;
        }
        DequeNode *node = front;
        value = node->data;
        front = node->next;
        if (front)
        {
            front->previous = nullptr;
        }
        else
        {
            back = nullptr;
        }
        delete node;
        return true;
    }

    bool popBack(int &value)
    {
        if (empty())
        {
            return false;
        }
        DequeNode *node = back;
        value = node->data;
        back = node->previous;
        if (back)
        {
            back->next = nullptr;
        }
        else
        {
            front = nullptr;
        }
        delete node;
        return true;
    }

    ~LinkedListDeque()
    {
        int value;
        while (popFront(value))
        {
        }
    }
};

