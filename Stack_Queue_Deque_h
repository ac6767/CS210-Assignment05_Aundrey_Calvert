    /////////////////////////////////////////////////// Array Stack ///////////////////////////////////////////////////////////////
/* clang-format on */

class ArrayStack
{
private:
    int allocationSize;
    int *array;
    int stackLength;
    int maxLength;

    void Resize()
    {
        // Allocate new array and copy existing items
        int newSize = allocationSize * 2;
        int *newArray = new int[newSize];
        for (int i = 0; i < stackLength; i++)
        {
            newArray[i] = array[i];
        }

        // Free old array and assign new
        delete[] array;
        array = newArray;
        allocationSize = newSize;
    }

public:
    ArrayStack(int optionalMaxLength = -1)
    {
        allocationSize = 1;
        array = new int[allocationSize];
        stackLength = 0;
        maxLength = optionalMaxLength;
    }

    int GetLength() const
    {
        return stackLength;
    }

    int GetMaxLength() const
    {
        return maxLength;
    }

    bool Push(int item)
    {
        // If at max length, return false
        if (stackLength == maxLength)
        {
            return false;
        }

        // Resize if length equals allocation size
        if (stackLength == allocationSize)
        {
            Resize();
        }

        // Push the item and return true
        array[stackLength] = item;
        stackLength++;
        return true;
    }

    int Pop()
    {
        stackLength--;
        return array[stackLength];
    }

    bool isEmpty()
    {
        return stackLength == 0;
    }

    bool IsEmpty()
    {
        return stackLength == 0;
    }

    bool empty() const
    {
        return stackLength == 0;
    }

    bool push(int value)
    {
        return Push(value);
    }

    bool pop(int &value)
    {
        if (empty())
        {
            return false;
        }
        value = Pop();
        return true;
    }

    virtual ~ArrayStack()
    {
        delete[] array;
    }
};

