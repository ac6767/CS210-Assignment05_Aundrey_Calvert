class ArrayDeque
{
private:
    int *data;
    int capacity;
    int frontIndex;
    int count;

    void Resize()
    {
        int newCap = capacity * 2;
        int *newData = new int[newCap];
        for (int i = 0; i < count; i++)
            newData[i] = data[(frontIndex + i) % capacity];
        delete[] data;
        data = newData;
        capacity = newCap;
        frontIndex = 0;
    }

public:
    ArrayDeque() : data(new int[1]), capacity(1), frontIndex(0), count(0) {}
    ArrayDeque(const ArrayDeque &) = delete;
    ArrayDeque &operator=(const ArrayDeque &) = delete;

    bool empty() const { return count == 0; }

    bool pushBack(int v)
    {
        if (count == capacity)
            Resize();
        data[(frontIndex + count) % capacity] = v;
        count++;
        return true;
    }

    bool pushFront(int v)
    {
        if (count == capacity)
            Resize();
        frontIndex = (frontIndex - 1 + capacity) % capacity;
        data[frontIndex] = v;
        count++;
        return true;
    }

    bool popFront(int &v)
    {
        if (empty())
            return false;
        v = data[frontIndex];
        frontIndex = (frontIndex + 1) % capacity;
        count--;
        return true;
    }

    bool popBack(int &v)
    {
        if (empty())
            return false;
        v = data[(frontIndex + count - 1) % capacity];
        count--;
        return true;
    }

    ~ArrayDeque() { delete[] data; }
};
