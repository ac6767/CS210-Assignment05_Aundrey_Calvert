// Node to store an item in a linked-list-based stack
class StackNode
{
public:
    int data;
    StackNode *next;

    StackNode(int dataValue, StackNode *nextNode)
    {
        data = dataValue;
        next = nextNode;
    }
};

class LinkedListStack
{
private:
    StackNode *top;

public:
    LinkedListStack()
    {
        top = nullptr;
    }

    LinkedListStack(const vector<int> &values)
    {
        top = nullptr;
        for (int value : values)
        {
            Push(value);
        }
    }

    void Push(int newData)
    {
        top = new StackNode(newData, top);
    }

    int Pop()
    {
        // Copy top node's data
        StackNode *poppedNode = top;
        int poppedItem = top->data;

        // Remove top node
        top = top->next;

        // Delete former top node
        delete poppedNode;

        // Return the popped item
        return poppedItem;
    }

    bool IsEmpty()
    {
        return top == nullptr;
    };

    bool empty() const
    {
        return top == nullptr;
    }

    bool push(int value)
    {
        Push(value);
        return true;
    }

    bool pop(int &value)
    {
        if (empty())
        {
            return false;
        }
        value = Pop();
        return true;
    }

    ~LinkedListStack()
    {
        while (top)
        {
            StackNode *nodeToDelete = top;
            top = top->next;
            delete nodeToDelete;
        }
    }
};

