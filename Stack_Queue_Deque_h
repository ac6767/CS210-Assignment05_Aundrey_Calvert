class QueueNode
{
public:
    int data;
    QueueNode *next;

    QueueNode(int dataValue, QueueNode *nextNode = nullptr)
    {
        data = dataValue;
        next = nextNode;
    }
};

class LinkedListQueue
{
private:
    QueueNode *front;
    QueueNode *end;

public:
    LinkedListQueue()
    {
        front = nullptr;
        end = nullptr;
    }

    LinkedListQueue(const vector<int> &values)
    {
        front = nullptr;
        end = nullptr;
        for (int value : values)
        {
            Enqueue(value);
        }
    }

    void Enqueue(int newData)
    {
        QueueNode *newNode = new QueueNode(newData);
        if (nullptr == front)
        {
            front = newNode;
        }
        else
        {
            end->next = newNode;
        }
        end = newNode;
    }

    int Dequeue()
    {
        QueueNode *dequeuedNode = front;
        int dequeuedItem = front->data;

        front = front->next;
        delete dequeuedNode;

        if (nullptr == front)
        {
            end = nullptr;
        }

        return dequeuedItem;
    }

    bool IsEmpty()
    {
        return nullptr == front;
    }

    int Peek()
    {
        return front->data;
    }

    int GetLength()
    {
        int length = 0;
        QueueNode *node = front;
        while (node)
        {
            length++;
            node = node->next;
        }
        return length;
    }

    void Print(ostream &printStream = cout, const string &separator = ", ")
    {
        QueueNode *node = front;
        if (node)
        {
            // Front item is not preceded by separator
            printStream << node->data;
            node = node->next;
        }
        while (node)
        {
            // Each item after the front is preceded by the separator
            printStream << separator << node->data;
            node = node->next;
        }
        cout << endl;
    }

    ~LinkedListQueue()
    {
        while (front)
        {
            QueueNode *nodeToDelete = front;
            front = front->next;
            delete nodeToDelete;
        }
    }
};

